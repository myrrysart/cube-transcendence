# Secrets and local configuration
.env
.env.*
!.env.example

# Dependencies and generated application output
node_modules/
dist/
coverage/
*.log

# Exported local CA certificate (never export the CA private key)
setup/local-ca.crt

# Local database data and editor/OS state
postgres-data/
.DS_Store
.idea/
.vscode/

# AI working area: only its directory markers are shared
.scratch/*
!.scratch/tmp/
!.scratch/tmp/.gitkeep
!.scratch/plan/
!.scratch/plan/.gitkeep

# Deepwork state is local and disposable
.slim/deepwork/
