# PostgreSQL development database. Replace only in your untracked .env file.
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=transcendence
POSTGRES_PORT=5432

# Local NestJS service configuration (host process)
DATABASE_URL=postgresql://transcendence:change-me-before-use@127.0.0.1:5432/transcendence?schema=public
APP_PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
ENABLE_DEV_SESSION=true
