# PostgreSQL development database. Replace only in your untracked .env file.
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=transcendence
POSTGRES_PORT=5432

# Future NestJS service configuration
DATABASE_URL=postgresql://transcendence:change-me-before-use@db:5432/transcendence?schema=public
APP_PORT=3000
APP_ORIGIN=https://localhost
