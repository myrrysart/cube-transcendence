# Local PostgreSQL. Replace the password with a long random URL-safe value.
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=transcendence

# HTTPS for this computer. For LAN, set SITE_HOST to the host LAN IPv4 address.
SITE_HOST=localhost
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8443
APP_ORIGIN=https://localhost:8443

# Guests are disabled in the production-mode HTTPS stack.
# Optional HTTP host-development override can enable them.
ENABLE_DEV_SESSION=false

# Optional host-development ports (compose.backend.yaml only).
POSTGRES_PORT=5432
APP_PORT=3000
